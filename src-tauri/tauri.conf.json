{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RECO",
  "version": "0.1.0",
  "identifier": "app.reco.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RECO",
        "width": 360,
        "height": 396,
        "resizable": false,
        "center": false,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "indicator",
        "title": "RECO indicador",
        "url": "indicator.html",
        "width": 64,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Dictado y grabación de pantalla con Notion",
    "longDescription": "RECO combina dictado local por voz y grabación de pantalla con subida por partes a Notion.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
